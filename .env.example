# Google Gemini API Configuration (Supported)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Configuration (Supported)
LLM_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini

# RAG Pipeline Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=75
TOP_K=5
SIMILARITY_THRESHOLD=0.30
DATA_DIR=data
PERSIST_DIRECTORY=data/vector_store

# Security & Safeguards Configuration
MAX_UPLOAD_SIZE_MB=10
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
ADMIN_API_KEY=

# Fallback Configuration
ALLOW_EXTRACTIVE_FALLBACK=false
